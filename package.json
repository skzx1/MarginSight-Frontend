{
  "name": "marginsight-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "npm run dev -w web",
    "typecheck": "npm run typecheck -w web",
    "test": "node --test tests/*.test.mjs",
    "build": "npm run build -w web",
    "verify": "node scripts/verify.mjs",
    "sync:preview": "node scripts/sync-preview.mjs",
    "package:deploy": "node scripts/package-deploy.mjs"
  }
}
